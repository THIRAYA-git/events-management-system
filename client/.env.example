# Base URL of the backend API (must match the server PORT)
VITE_API_URL=http://localhost:5000/api

# Show the PayHere sandbox checkout (true for demo/testing)
VITE_PAYHERE_SANDBOX=true

# Google OAuth Web client ID (same value as GOOGLE_CLIENT_ID in server/.env)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com