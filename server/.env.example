# ── Database ──────────────────────────────────────────────────
DB_MODE=local
LOCAL_DATABASE_URL=postgresql://postgres:<your_password>@localhost:5432/ems_db

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT (use long random strings, all three must be set) ──────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# ── Frontend / CORS ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173

# ── Cloudinary (optional: image uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email via SendGrid (optional) ─────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=your_verified_sender_email

# ── SMS via Text.LK (optional) ────────────────────────────────
TEXTLK_API_TOKEN=your_textlk_api_token
TEXTLK_SENDER_ID=your_textlk_sender_id

# ── PayHere sandbox (optional) ────────────────────────────────
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_RETURN_URL=http://localhost:5173/booking/success
PAYHERE_CANCEL_URL=http://localhost:5173/booking/cancel

# Public address of this backend. PayHere notify URLs are built from it:
#   halls: API_BASE_URL/api/payments/notify
#   rooms: API_BASE_URL/api/rooms/payments/notify
# Local default below. For the full PayHere callback test, replace it with
# your ngrok address, e.g. https://<your-subdomain>.ngrok-free.dev (no trailing slash)
API_BASE_URL=http://localhost:5000

# Sandbox aid: confirms a payment when PayHere cannot reach localhost.
# Ignored when NODE_ENV=production.
ALLOW_DEV_PAYMENT_CONFIRM=true

# ── Google sign-in (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id

# ── Database backup (NFR-017) ─────────────────────────────────
# Full path to pg_dump on your machine
PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe

# ── Test materials (used by the test scripts only) ────────────
# These must match accounts that exist in your seeded database.
ADMIN_EMAIL=admin@aazathplaza.lk
ADMIN_PW=NewAdmin@123
FD_EMAIL=staff@aazathplaza.lk
FD_PW=Staff@1234
CUSTOMER_PW=test@123
TEST_HALL_ID=5
