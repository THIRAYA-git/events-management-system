DATABASE_URL=postgresql://postgres:123@localhost:5432/EMS_DB

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ems_db
DB_USER=postgres
DB_PASSWORD=your_password

# ── JWT Authentication (3 secrets — all must be set) ────────────────────────
# Used by your old code (keep for now if anything still uses it)
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Used by auth.service.js for access token (15 min)
JWT_ACCESS_SECRET=your_jwt_access_secret_key

# Used by auth.service.js for refresh token (7 days)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# ── Frontend URL (for CORS + password reset links) ────────────
FRONTEND_URL=http://localhost:5173


# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=your_Email

# ── TextLK (SMS) ──────────────────────────────────────────────
TEXTLK_API_TOKEN=your_textlk_api_token 
TEXTLK_SENDER_ID=your_textlk_sender_id

# ── Payhere (Payment Gateway) ──────────────────────────────────────────────
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_NOTIFY_URL=https://boneless-nest-slapstick.ngrok-free.dev/api/payments/notify
PAYHERE_RETURN_URL=http://localhost:3000/booking/success
PAYHERE_CANCEL_URL=http://localhost:3000/booking/cancel

# Client URL (for CORS)
CLIENT_BASE_URL=http://localhost:5173
API_BASE_URL=https://boneless-nest-slapstick.ngrok-free.dev

