# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL) - local database named EMS_DB
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/EMS_DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=EMS_DB
DB_USER=postgres
DB_PASSWORD=your_password

# JWT (use any long random strings)
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Frontend URL (CORS and password reset links)
FRONTEND_URL=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173

# Cloudinary (image upload) - optional
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email via SendGrid SMTP - optional
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=your_verified_sender_email

# SMS via text.lk - optional
TEXTLK_API_TOKEN=your_textlk_api_token
TEXTLK_SENDER_ID=your_textlk_sender_id

# PayHere sandbox - optional
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_RETURN_URL=http://localhost:5173/booking/success
PAYHERE_CANCEL_URL=http://localhost:5173/booking/cancel
# Public URL so PayHere can reach your server (e.g. from ngrok). Leave as is to skip.
PAYHERE_NOTIFY_URL=https://your-public-url/api/payments/notify
API_BASE_URL=http://localhost:5000

# Sign in with Google - optional
GOOGLE_CLIENT_ID=your_google_client_id